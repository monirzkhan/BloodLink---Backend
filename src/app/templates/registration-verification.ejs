<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BloodLink - Email Verification</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f8f9fa;
  font-family:Arial, Helvetica, sans-serif;
  color:#1f2937;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color:#f8f9fa;
      padding:40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background:#ffffff;
            border-radius:14px;
            overflow:hidden;
            border:1px solid #e5e7eb;
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              style="
                background:#b91c1c;
                padding:32px 25px;
                text-align:center;
              "
            >

              <!-- BloodLink Logo -->
              <table
                cellpadding="0"
                cellspacing="0"
                border="0"
                align="center"
              >
                <tr>
                  <td align="center">

                    <!-- Blood Drop -->
                    <div
                      style="
                        width:58px;
                        height:58px;
                        margin:0 auto 12px;
                        background:#ffffff;
                        border-radius:50%;
                        text-align:center;
                        line-height:58px;
                        font-size:30px;
                      "
                    >
                      🩸
                    </div>

                    <!-- Brand -->
                    <div
                      style="
                        color:#ffffff;
                        font-size:28px;
                        font-weight:800;
                        letter-spacing:0.5px;
                      "
                    >
                      BloodLink
                    </div>

                    <div
                      style="
                        color:#fee2e2;
                        font-size:13px;
                        margin-top:6px;
                      "
                    >
                      Connecting Lives Through Blood
                    </div>

                  </td>
                </tr>
              </table>

            </td>
          </tr>


          <!-- ================= TITLE ================= -->
          <tr>
            <td
              style="
                padding:35px 35px 10px;
                text-align:center;
              "
            >

              <div
                style="
                  display:inline-block;
                  width:48px;
                  height:48px;
                  line-height:48px;
                  border-radius:50%;
                  background:#fef2f2;
                  color:#dc2626;
                  font-size:22px;
                  margin-bottom:12px;
                "
              >
                ✓
              </div>

              <h1
                style="
                  margin:0;
                  font-size:25px;
                  font-weight:700;
                  color:#111827;
                "
              >
                Verify Your Email
              </h1>

              <p
                style="
                  margin:8px 0 0;
                  font-size:14px;
                  color:#6b7280;
                "
              >
                Confirm your email address to continue
              </p>

            </td>
          </tr>


          <!-- ================= CONTENT ================= -->
          <tr>
            <td
              style="
                padding:25px 35px 40px;
              "
            >

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 18px;
                  font-size:16px;
                  line-height:1.6;
                  color:#1f2937;
                "
              >
                Hi <strong><%= name %></strong>,
              </p>


              <p
                style="
                  margin:0 0 25px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                Welcome to <strong style="color:#b91c1c;">BloodLink</strong>.
                We received a request to verify your email address.
                Please use the verification code below to complete your
                registration.
              </p>


              <!-- ================= OTP ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#fff7f7;
                  border:1px solid #fecaca;
                  border-radius:12px;
                "
              >
                <tr>
                  <td
                    align="center"
                    style="padding:25px 15px;"
                  >

                    <div
                      style="
                        font-size:11px;
                        font-weight:700;
                        color:#991b1b;
                        text-transform:uppercase;
                        letter-spacing:2px;
                        margin-bottom:12px;
                      "
                    >
                      Email Verification Code
                    </div>

                    <div
                      style="
                        font-size:36px;
                        font-weight:800;
                        letter-spacing:9px;
                        color:#b91c1c;
                      "
                    >
                      <%= otp %>
                    </div>

                  </td>
                </tr>
              </table>


              <!-- Expiration -->
              <p
                style="
                  margin:18px 0 0;
                  text-align:center;
                  font-size:14px;
                  color:#6b7280;
                "
              >
                This verification code will expire in
                <strong style="color:#b91c1c;">
                  <%= expirationTime %> minutes
                </strong>.
              </p>


              <!-- Security Notice -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top:28px;
                  background:#f9fafb;
                  border-radius:10px;
                "
              >
                <tr>
                  <td
                    style="
                      padding:16px;
                      font-size:13px;
                      line-height:1.6;
                      color:#6b7280;
                    "
                  >

                    <strong style="color:#374151;">
                      🔒 Security Notice
                    </strong>

                    <br />

                    Never share this verification code with anyone.
                    BloodLink will never ask you for your OTP by phone,
                    message, or email.

                  </td>
                </tr>
              </table>


              <!-- Didn't Request -->
              <p
                style="
                  margin:25px 0 0;
                  font-size:13px;
                  line-height:1.6;
                  color:#9ca3af;
                  text-align:center;
                "
              >
                If you didn't request this verification code,
                you can safely ignore this email.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              style="
                background:#f9fafb;
                padding:25px 30px;
                text-align:center;
                border-top:1px solid #e5e7eb;
              "
            >

              <!-- Mini Logo -->
              <div
                style="
                  font-size:18px;
                  font-weight:800;
                  color:#b91c1c;
                  margin-bottom:8px;
                "
              >
                🩸 BloodLink
              </div>

              <p
                style="
                  margin:0;
                  font-size:12px;
                  color:#9ca3af;
                  line-height:1.5;
                "
              >
                Connecting donors with those who need blood.
              </p>

              <p
                style="
                  margin:12px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                © <%= new Date().getFullYear() %> BloodLink.
                All rights reserved.
              </p>

              <p
                style="
                  margin:6px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                This is an automated email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>