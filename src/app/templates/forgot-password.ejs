
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BloodLink - Password Reset OTP</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f8f9fa;
  font-family:Arial, Helvetica, sans-serif;
  color:#1f2937;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color:#f8f9fa;
      padding:40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background:#ffffff;
            border-radius:14px;
            overflow:hidden;
            border:1px solid #e5e7eb;
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              style="
                background:#b91c1c;
                padding:35px 25px;
                text-align:center;
              "
            >

              <!-- BloodLink Logo -->
              <div
                style="
                  width:60px;
                  height:60px;
                  margin:0 auto 12px;
                  background:#ffffff;
                  border-radius:50%;
                  text-align:center;
                  line-height:60px;
                  font-size:31px;
                "
              >
                🩸
              </div>

              <div
                style="
                  color:#ffffff;
                  font-size:28px;
                  font-weight:800;
                  letter-spacing:0.5px;
                "
              >
                BloodLink
              </div>

              <div
                style="
                  color:#fee2e2;
                  font-size:13px;
                  margin-top:6px;
                "
              >
                Connecting Lives Through Blood
              </div>

            </td>
          </tr>


          <!-- ================= TITLE ================= -->
          <tr>
            <td
              style="
                padding:35px 35px 10px;
                text-align:center;
              "
            >

              <!-- Lock Icon -->
              <div
                style="
                  width:54px;
                  height:54px;
                  line-height:54px;
                  margin:0 auto 14px;
                  border-radius:50%;
                  background:#fef2f2;
                  color:#b91c1c;
                  font-size:25px;
                "
              >
                🔐
              </div>

              <h1
                style="
                  margin:0;
                  color:#111827;
                  font-size:26px;
                  font-weight:700;
                "
              >
                Reset Your Password
              </h1>

              <p
                style="
                  margin:9px 0 0;
                  color:#6b7280;
                  font-size:14px;
                "
              >
                Your password reset verification code
              </p>

            </td>
          </tr>


          <!-- ================= CONTENT ================= -->
          <tr>
            <td
              style="
                padding:25px 35px 40px;
              "
            >

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 18px;
                  font-size:17px;
                  line-height:1.6;
                  color:#1f2937;
                "
              >
                Hi <strong><%= name %></strong>,
              </p>


              <!-- Message -->
              <p
                style="
                  margin:0 0 25px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                We received a request to reset the password for
                your <strong style="color:#b91c1c;">BloodLink</strong>
                account.
              </p>

              <p
                style="
                  margin:0 0 25px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                Enter the verification code below to continue
                with your password reset.
              </p>


              <!-- ================= OTP BOX ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#fff7f7;
                  border:1px solid #fecaca;
                  border-radius:12px;
                  margin-bottom:20px;
                "
              >
                <tr>
                  <td
                    align="center"
                    style="
                      padding:25px 15px;
                    "
                  >

                    <div
                      style="
                        font-size:11px;
                        font-weight:700;
                        color:#991b1b;
                        text-transform:uppercase;
                        letter-spacing:2px;
                        margin-bottom:12px;
                      "
                    >
                      Password Reset OTP
                    </div>

                    <div
                      style="
                        font-size:36px;
                        font-weight:800;
                        letter-spacing:9px;
                        color:#b91c1c;
                      "
                    >
                      <%= otp %>
                    </div>

                  </td>
                </tr>
              </table>


              <!-- ================= EXPIRATION ================= -->
              <% if (expirationTime) { %>

              <p
                style="
                  margin:0 0 25px;
                  text-align:center;
                  font-size:14px;
                  color:#6b7280;
                "
              >
                This OTP will expire in
                <strong style="color:#b91c1c;">
                  <%= expirationTime %> minutes
                </strong>.
              </p>

              <% } %>


              <!-- ================= SECURITY NOTICE ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#fff7ed;
                  border:1px solid #fed7aa;
                  border-radius:10px;
                  margin-bottom:25px;
                "
              >
                <tr>
                  <td
                    style="
                      padding:18px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 7px;
                        font-size:14px;
                        font-weight:700;
                        color:#c2410c;
                      "
                    >
                      🔒 Security Notice
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:13px;
                        line-height:1.6;
                        color:#9a3412;
                      "
                    >
                      Never share this OTP with anyone.
                      BloodLink will never ask you to provide your
                      verification code by phone, message, or email.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= DIDN'T REQUEST ================= -->
              <p
                style="
                  margin:0;
                  font-size:13px;
                  line-height:1.6;
                  color:#9ca3af;
                  text-align:center;
                "
              >
                If you didn't request a password reset,
                you can safely ignore this email.
                Your password will remain unchanged.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              style="
                background:#f9fafb;
                padding:25px 30px;
                text-align:center;
                border-top:1px solid #e5e7eb;
              "
            >

              <div
                style="
                  font-size:19px;
                  font-weight:800;
                  color:#b91c1c;
                  margin-bottom:8px;
                "
              >
                🩸 BloodLink
              </div>

              <p
                style="
                  margin:0;
                  font-size:12px;
                  line-height:1.5;
                  color:#9ca3af;
                "
              >
                Connecting donors with those who need blood.
              </p>

              <p
                style="
                  margin:12px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                © <%= new Date().getFullYear() %> BloodLink.
                All rights reserved.
              </p>

              <p
                style="
                  margin:6px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                This is an automated security email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>

