
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to BloodLink</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f8f9fa;
  font-family:Arial, Helvetica, sans-serif;
  color:#1f2937;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color:#f8f9fa;
      padding:40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background:#ffffff;
            border-radius:14px;
            overflow:hidden;
            border:1px solid #e5e7eb;
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              style="
                background:#b91c1c;
                padding:35px 25px;
                text-align:center;
              "
            >

              <!-- BloodLink Logo -->
              <table
                cellpadding="0"
                cellspacing="0"
                border="0"
                align="center"
              >
                <tr>
                  <td align="center">

                    <!-- Blood Drop Logo -->
                    <div
                      style="
                        width:60px;
                        height:60px;
                        margin:0 auto 12px;
                        background:#ffffff;
                        border-radius:50%;
                        text-align:center;
                        line-height:60px;
                        font-size:31px;
                      "
                    >
                      🩸
                    </div>

                    <!-- Brand -->
                    <div
                      style="
                        color:#ffffff;
                        font-size:28px;
                        font-weight:800;
                        letter-spacing:0.5px;
                      "
                    >
                      BloodLink
                    </div>

                    <div
                      style="
                        color:#fee2e2;
                        font-size:13px;
                        margin-top:6px;
                      "
                    >
                      Connecting Lives Through Blood
                    </div>

                  </td>
                </tr>
              </table>

            </td>
          </tr>


          <!-- ================= WELCOME TITLE ================= -->
          <tr>
            <td
              style="
                padding:35px 35px 10px;
                text-align:center;
              "
            >

              <!-- Welcome Icon -->
              <div
                style="
                  width:52px;
                  height:52px;
                  line-height:52px;
                  margin:0 auto 14px;
                  border-radius:50%;
                  background:#fef2f2;
                  color:#b91c1c;
                  font-size:24px;
                "
              >
                ✓
              </div>

              <h1
                style="
                  margin:0;
                  color:#111827;
                  font-size:26px;
                  font-weight:700;
                "
              >
                Welcome to BloodLink!
              </h1>

              <p
                style="
                  margin:9px 0 0;
                  color:#6b7280;
                  font-size:14px;
                "
              >
                Your account has been created successfully
              </p>

            </td>
          </tr>


          <!-- ================= CONTENT ================= -->
          <tr>
            <td
              style="
                padding:25px 35px 40px;
              "
            >

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 18px;
                  font-size:17px;
                  line-height:1.6;
                  color:#1f2937;
                "
              >
                Hi <strong><%= name %></strong>,
              </p>


              <!-- Introduction -->
              <p
                style="
                  margin:0 0 18px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                Welcome to
                <strong style="color:#b91c1c;">BloodLink</strong>!
                We're glad to have you as part of our community.
              </p>


              <p
                style="
                  margin:0 0 25px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                Your registration has been completed successfully,
                and your account is now ready to use.
                Together, we can help connect people who need blood
                with those who are ready to donate.
              </p>


              <!-- ================= SUCCESS BOX ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#fef2f2;
                  border:1px solid #fecaca;
                  border-radius:12px;
                  margin-bottom:25px;
                "
              >
                <tr>
                  <td
                    style="
                      padding:20px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 8px;
                        font-size:14px;
                        font-weight:700;
                        color:#b91c1c;
                      "
                    >
                      ✓ Registration Successful
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:13px;
                        line-height:1.6;
                        color:#7f1d1d;
                      "
                    >
                      Your BloodLink account has been successfully
                      created and is ready to use.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= ACCOUNT INFORMATION ================= -->
              <% if (email) { %>

              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#f9fafb;
                  border-radius:12px;
                  margin-bottom:25px;
                  border:1px solid #f1f5f9;
                "
              >
                <tr>
                  <td
                    style="
                      padding:20px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 10px;
                        font-size:11px;
                        font-weight:700;
                        color:#64748b;
                        text-transform:uppercase;
                        letter-spacing:1.5px;
                      "
                    >
                      Account Email
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:15px;
                        font-weight:600;
                        color:#1e293b;
                      "
                    >
                      <%= email %>
                    </p>

                  </td>
                </tr>
              </table>

              <% } %>


              <!-- ================= NEXT STEP ================= -->
              <p
                style="
                  margin:0 0 20px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                You can now log in to your BloodLink account and
                start using our platform.
              </p>


              <!-- ================= CTA ================= -->
              <% if (loginUrl) { %>

              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      padding:5px 0 25px;
                    "
                  >

                    <a
                      href="<%= loginUrl %>"
                      style="
                        display:inline-block;
                        background:#b91c1c;
                        color:#ffffff;
                        text-decoration:none;
                        font-size:15px;
                        font-weight:700;
                        padding:14px 32px;
                        border-radius:8px;
                      "
                    >
                      Login to BloodLink
                    </a>

                  </td>
                </tr>
              </table>

              <% } %>


              <!-- ================= MISSION ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#f9fafb;
                  border-radius:10px;
                  margin-bottom:22px;
                "
              >
                <tr>
                  <td
                    align="center"
                    style="
                      padding:18px 15px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 7px;
                        font-size:14px;
                        font-weight:700;
                        color:#374151;
                      "
                    >
                      🩸 Every Drop Can Make a Difference
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:12px;
                        line-height:1.6;
                        color:#6b7280;
                      "
                    >
                      BloodLink connects donors, patients, hospitals,
                      and communities to make blood access easier
                      when it matters most.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- Security -->
              <p
                style="
                  margin:0;
                  font-size:12px;
                  line-height:1.6;
                  color:#9ca3af;
                  text-align:center;
                "
              >
                If you did not create this account, please contact
                our support team immediately.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              style="
                background:#f9fafb;
                padding:25px 30px;
                text-align:center;
                border-top:1px solid #e5e7eb;
              "
            >

              <!-- Footer Logo -->
              <div
                style="
                  font-size:19px;
                  font-weight:800;
                  color:#b91c1c;
                  margin-bottom:8px;
                "
              >
                🩸 BloodLink
              </div>

              <p
                style="
                  margin:0;
                  font-size:12px;
                  line-height:1.5;
                  color:#9ca3af;
                "
              >
                Connecting donors with those who need blood.
              </p>

              <p
                style="
                  margin:12px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                © <%= new Date().getFullYear() %> BloodLink.
                All rights reserved.
              </p>

              <p
                style="
                  margin:6px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                This is an automated email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>