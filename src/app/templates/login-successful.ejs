
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Successful Login - BloodLink</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f8f9fa;
  font-family:Arial, Helvetica, sans-serif;
  color:#1f2937;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color:#f8f9fa;
      padding:40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:600px;
            background:#ffffff;
            border-radius:14px;
            overflow:hidden;
            border:1px solid #e5e7eb;
          "
        >

          <!-- ================= HEADER ================= -->
          <tr>
            <td
              style="
                background:#b91c1c;
                padding:35px 25px;
                text-align:center;
              "
            >

              <!-- BloodLink Logo -->
              <div
                style="
                  width:60px;
                  height:60px;
                  margin:0 auto 12px;
                  background:#ffffff;
                  border-radius:50%;
                  text-align:center;
                  line-height:60px;
                  font-size:31px;
                "
              >
                🩸
              </div>

              <div
                style="
                  color:#ffffff;
                  font-size:28px;
                  font-weight:800;
                  letter-spacing:0.5px;
                "
              >
                BloodLink
              </div>

              <div
                style="
                  color:#fee2e2;
                  font-size:13px;
                  margin-top:6px;
                "
              >
                Connecting Lives Through Blood
              </div>

            </td>
          </tr>


          <!-- ================= TITLE ================= -->
          <tr>
            <td
              style="
                padding:35px 35px 10px;
                text-align:center;
              "
            >

              <!-- Success Icon -->
              <div
                style="
                  width:54px;
                  height:54px;
                  line-height:54px;
                  margin:0 auto 14px;
                  border-radius:50%;
                  background:#f0fdf4;
                  color:#16a34a;
                  font-size:26px;
                  font-weight:700;
                "
              >
                ✓
              </div>

              <h1
                style="
                  margin:0;
                  color:#111827;
                  font-size:26px;
                  font-weight:700;
                "
              >
                Login Successful
              </h1>

              <p
                style="
                  margin:9px 0 0;
                  color:#6b7280;
                  font-size:14px;
                "
              >
                Your BloodLink account was accessed successfully
              </p>

            </td>
          </tr>


          <!-- ================= CONTENT ================= -->
          <tr>
            <td
              style="
                padding:25px 35px 40px;
              "
            >

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 18px;
                  font-size:17px;
                  line-height:1.6;
                  color:#1f2937;
                "
              >
                Hi <strong><%= name %></strong>,
              </p>


              <!-- Message -->
              <p
                style="
                  margin:0 0 25px;
                  font-size:15px;
                  line-height:1.7;
                  color:#4b5563;
                "
              >
                You have successfully logged in to your
                <strong style="color:#b91c1c;">BloodLink</strong>
                account.
              </p>


              <!-- ================= SUCCESS BOX ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#f0fdf4;
                  border:1px solid #bbf7d0;
                  border-radius:12px;
                  margin-bottom:25px;
                "
              >
                <tr>
                  <td style="padding:20px;">

                    <p
                      style="
                        margin:0 0 8px;
                        font-size:14px;
                        font-weight:700;
                        color:#15803d;
                      "
                    >
                      ✓ Login Successful
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:13px;
                        line-height:1.6;
                        color:#166534;
                      "
                    >
                      Your account was accessed successfully.
                      If this was you, no further action is required.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= LOGIN DETAILS ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#f9fafb;
                  border-radius:12px;
                  border:1px solid #f1f5f9;
                  margin-bottom:25px;
                "
              >

                <!-- Login Time -->
                <% if (loginTime) { %>
                <tr>
                  <td
                    style="
                      padding:16px 20px;
                      border-bottom:1px solid #e5e7eb;
                    "
                  >
                    <p
                      style="
                        margin:0 0 6px;
                        font-size:11px;
                        font-weight:700;
                        color:#64748b;
                        text-transform:uppercase;
                        letter-spacing:1.3px;
                      "
                    >
                      Login Time
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:14px;
                        font-weight:600;
                        color:#1e293b;
                      "
                    >
                      <%= loginTime %>
                    </p>
                  </td>
                </tr>
                <% } %>


                <!-- Device -->
                <% if (device) { %>
                <tr>
                  <td
                    style="
                      padding:16px 20px;
                      border-bottom:1px solid #e5e7eb;
                    "
                  >
                    <p
                      style="
                        margin:0 0 6px;
                        font-size:11px;
                        font-weight:700;
                        color:#64748b;
                        text-transform:uppercase;
                        letter-spacing:1.3px;
                      "
                    >
                      Device
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:14px;
                        font-weight:600;
                        color:#1e293b;
                      "
                    >
                      <%= device %>
                    </p>
                  </td>
                </tr>
                <% } %>


                <!-- IP Address -->
                <% if (ipAddress) { %>
                <tr>
                  <td
                    style="
                      padding:16px 20px;
                    "
                  >
                    <p
                      style="
                        margin:0 0 6px;
                        font-size:11px;
                        font-weight:700;
                        color:#64748b;
                        text-transform:uppercase;
                        letter-spacing:1.3px;
                      "
                    >
                      IP Address
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:14px;
                        font-weight:600;
                        color:#1e293b;
                      "
                    >
                      <%= ipAddress %>
                    </p>
                  </td>
                </tr>
                <% } %>

              </table>


              <!-- ================= SECURITY NOTICE ================= -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background:#fff7ed;
                  border:1px solid #fed7aa;
                  border-radius:10px;
                  margin-bottom:25px;
                "
              >
                <tr>
                  <td
                    style="
                      padding:18px;
                    "
                  >

                    <p
                      style="
                        margin:0 0 7px;
                        font-size:14px;
                        font-weight:700;
                        color:#c2410c;
                      "
                    >
                      🔒 Wasn't You?
                    </p>

                    <p
                      style="
                        margin:0;
                        font-size:13px;
                        line-height:1.6;
                        color:#9a3412;
                      "
                    >
                      If you don't recognize this login, please change
                      your password immediately and contact the BloodLink
                      support team.
                    </p>

                  </td>
                </tr>
              </table>


              <!-- ================= CTA ================= -->
              <% if (loginUrl) { %>

              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      padding:5px 0 15px;
                    "
                  >

                    <a
                      href="<%= loginUrl %>"
                      style="
                        display:inline-block;
                        background:#b91c1c;
                        color:#ffffff;
                        text-decoration:none;
                        font-size:15px;
                        font-weight:700;
                        padding:14px 30px;
                        border-radius:8px;
                      "
                    >
                      Open BloodLink
                    </a>

                  </td>
                </tr>
              </table>

              <% } %>


              <p
                style="
                  margin:10px 0 0;
                  font-size:12px;
                  line-height:1.6;
                  color:#9ca3af;
                  text-align:center;
                "
              >
                Your account security is important to us.
                Never share your password or verification codes with anyone.
              </p>

            </td>
          </tr>


          <!-- ================= FOOTER ================= -->
          <tr>
            <td
              style="
                background:#f9fafb;
                padding:25px 30px;
                text-align:center;
                border-top:1px solid #e5e7eb;
              "
            >

              <!-- Footer Logo -->
              <div
                style="
                  font-size:19px;
                  font-weight:800;
                  color:#b91c1c;
                  margin-bottom:8px;
                "
              >
                🩸 BloodLink
              </div>

              <p
                style="
                  margin:0;
                  font-size:12px;
                  line-height:1.5;
                  color:#9ca3af;
                "
              >
                Connecting donors with those who need blood.
              </p>

              <p
                style="
                  margin:12px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                © <%= new Date().getFullYear() %> BloodLink.
                All rights reserved.
              </p>

              <p
                style="
                  margin:6px 0 0;
                  font-size:11px;
                  color:#c0c5cc;
                "
              >
                This is an automated security email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
