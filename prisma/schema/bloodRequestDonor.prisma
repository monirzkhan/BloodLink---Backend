model BloodRequestDonor {
  id                  String             @id @default(uuid())

  requestId           String
  request             BloodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  donorId             String
  donor               User               @relation(fields: [donorId], references: [id], onDelete: Cascade)

  matchScore          Float?
  distanceKm          Float?

  status              DonorOfferStatus   @default(OFFERED)

  notifiedAt          DateTime?
  respondedAt         DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  reservation         DonorReservation?


  @@unique([requestId, donorId])
  @@index([donorId])
  @@index([status])
  @@map("blood_request_donors")
}