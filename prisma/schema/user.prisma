model User {
  id String @id @default(uuid())

  name         String
  email        String?      @unique
  phone        String       @unique
  password     String?
  googleId     String?
  authProvider AuthProvider @default(CREDENTIALS)

  role   UserRole   @default(CALLER)
  status UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donorProfile    DonorProfile?
  patientProfile  PatientProfile?
  hospitalProfile HospitalProfile?

  // createdRequests BloodRequest[] @relation("RequestCreator")
  // patientRequests BloodRequest[] @relation("PatientRequests")
  // callerRequests  BloodRequest[] @relation("CallerRequests")

  // donorOffers  BloodRequestDonor[]
  // reservations DonorReservation[]

  // appointments Appointment[]
  // donations    Donation[]

  // payments Payment[]

  // notifications Notification[]

  // auditLogs AuditLog[]

  @@index([role])
  @@index([status])
}
