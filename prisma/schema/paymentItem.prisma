model PaymentItem {
  id                  String           @id @default(uuid())

  paymentId           String
  payment             Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type                PaymentItemType

  description         String

  amount              Decimal          @db.Decimal(12, 2)

  createdAt            DateTime         @default(now())

  @@index([paymentId])
  @@map("payment_items")
}
