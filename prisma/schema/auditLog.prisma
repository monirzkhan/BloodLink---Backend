model AuditLog {
  id        String @id @default(uuid())

  actorId   String?
  actor     User? @relation(fields: [actorId],references: [id])

  action    String
  entity    String
  entityId  String?

  oldData   Json?
  newData   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}