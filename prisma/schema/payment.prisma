model Payment {
  id                  String            @id @default(uuid())

  paymentNumber       String            @unique

  requestId           String
  request             BloodRequest      @relation(fields: [requestId], references: [id])

  payerId             String
  payer               User              @relation(fields: [payerId], references: [id])

  provider             PaymentProvider   @default(BKASH)

  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("BDT")

  merchantInvoiceNumber String @unique // blood request id

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReference String? // user email / phone number
  paidAt         String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundedAt   String?

  status               PaymentStatus    @default(PENDING)

  failureReason        String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  items                PaymentItem[]
  refunds              Refund[]


  @@index([requestId])
  @@index([payerId])
  @@index([status])
  @@map("payments")
}
